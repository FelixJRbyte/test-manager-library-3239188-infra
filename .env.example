# Manager Library: variables de entorno para `docker compose up`
#
# Uso:  copiar a `.env` y rellenar los valores vacíos.
#       `.env` está en .gitignore. Aquí no va ningún secreto real (Art. IX).
# Los valores vacíos son OBLIGATORIOS: el compose se negará a arrancar sin ellos.

# --- Motor de base de datos (PostgreSQL 16, arranca VACÍO: Art. V) ---
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=

# --- API (Laravel) ---
# Clave de cifrado de Laravel. Generarla con: php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=UTC
# Secreto para firmar los JWT (HS256). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Administrador inicial. Lo crea `php artisan library:ensure-admin` al arrancar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origen del frontend permitido por CORS (api-contract §4). Uno solo.
CORS_ORIGIN=http://localhost:5173

# Carpeta de portadas, relativa a la raíz de la API.
COVERS_DIR=storage/app/covers

# --- Puertos publicados en la máquina anfitriona ---
API_PORT=8000
